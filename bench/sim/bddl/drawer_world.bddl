(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the object in the drawer)
    (:regions
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (obj_a_init_region
          (:target kitchen_table)
          (:ranges (
              (0.04 -0.14 0.08 -0.10)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (obj_b_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 -0.21 0.01 -0.17)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (obj_c_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.12 -0.20 -0.08 -0.16)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    cream_cheese_1 - cream_cheese
    butter_1 - butter
    chocolate_pudding_1 - chocolate_pudding
  )

  (:obj_of_interest
    cream_cheese_1
    white_cabinet_1
  )

  (:init
    (On cream_cheese_1 kitchen_table_obj_a_init_region)
    (On butter_1 kitchen_table_obj_b_init_region)
    (On chocolate_pudding_1 kitchen_table_obj_c_init_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
  )

  (:goal
    (And (In cream_cheese_1 white_cabinet_1_top_region))
  )

)
